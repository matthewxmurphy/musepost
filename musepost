#!/usr/bin/env python3
"""MusePost: multi-mailbox email for the terminal and AI agents.

Developed for Muse.ai agent emails.
Credits: Taylor & Matthew Murphy — net30hosting.com
Previews and local drafts never submit mail. Use send, reply or drafts send
explicitly to submit; SMTP acceptance does not confirm recipient delivery.
"""

import argparse
from concurrent.futures import ThreadPoolExecutor
from email.utils import parseaddr
import json
import math
import os
from pathlib import Path
import sys
import uuid

import musepost_config as config
import musepost_mail as mail
import musepost_state as state

VERSION = Path(__file__).with_name("VERSION").read_text(encoding="utf-8").strip()
SCHEMA_VERSION = 1


class UsageError(Exception):
    code = "USAGE_ERROR"
    details = {}


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise UsageError(message)


def nonnegative(value):
    try:
        number = int(value)
        if number < 0:
            raise ValueError()
        return number
    except ValueError:
        raise argparse.ArgumentTypeError("must be a nonnegative integer") from None


def positive(value):
    number = nonnegative(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return number


def timeout_value(value):
    try:
        number = float(value)
        if not math.isfinite(number) or number <= 0:
            raise ValueError()
        return number
    except ValueError:
        raise argparse.ArgumentTypeError(
            "must be a positive number of seconds"
        ) from None


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--config",
        dest="config_path",
        default=argparse.SUPPRESS,
        help="owner-only JSON or legacy credentials file",
    )
    common.add_argument(
        "--json",
        dest="as_json",
        action="store_true",
        default=argparse.SUPPRESS,
        help="emit schema_version 1 JSON",
    )
    common.add_argument(
        "--timeout",
        type=timeout_value,
        default=argparse.SUPPRESS,
        help="socket timeout in seconds (default: 30)",
    )
    parser = Parser(description=__doc__, parents=[common])
    parser.add_argument("--version", action="version", version=VERSION)
    commands = parser.add_subparsers(dest="command", required=True)

    def command(name, description):
        return commands.add_parser(name, help=description, parents=[common])

    def folder(p):
        p.add_argument("--folder", default="INBOX")

    def compose(p):
        p.add_argument("--body", default="-", help="text or - for stdin")
        p.add_argument("--attach", action="append", default=[], metavar="FILE")
        p.add_argument("--signature", metavar="NAME")
        p.add_argument("--no-signature", action="store_true")
        p.add_argument(
            "--request-id",
            help="persistent retry key; same request never submits twice",
        )
        mode = p.add_mutually_exclusive_group()
        mode.add_argument(
            "--preview", action="store_true", help="compose without submission"
        )
        mode.add_argument(
            "--draft",
            action="store_true",
            help="save a private local draft without submission",
        )

    command("inboxes", "unread counts across accounts")
    p = command("unread", "unread headers across accounts")
    p.add_argument("account", nargs="?")
    p.add_argument("--limit", type=nonnegative, default=20)
    folder(p)
    p = command("list", "recent message headers")
    p.add_argument("account")
    p.add_argument("n", nargs="?", type=nonnegative, help="legacy message limit")
    p.add_argument("--limit", type=nonnegative)
    folder(p)
    for name in ("read", "peek"):
        p = command(name, "full message without changing its unread flag")
        p.add_argument("account")
        p.add_argument("uid", type=positive)
        p.add_argument(
            "--limit",
            type=nonnegative,
            help="optional body-character limit; reports truncation",
        )
        if name == "read":
            p.add_argument("--mark-read", action="store_true")
        folder(p)
    p = command("search", "search subject, sender and body")
    p.add_argument("account")
    p.add_argument("query", nargs="+")
    p.add_argument("--limit", type=nonnegative, default=20)
    folder(p)
    p = command("send", "explicitly submit new mail")
    p.add_argument("account")
    p.add_argument("--to", required=True)
    p.add_argument("--cc")
    p.add_argument("--subject", required=True)
    compose(p)
    p = command("reply", "explicitly submit a threaded reply")
    p.add_argument("account")
    p.add_argument("uid", type=positive)
    folder(p)
    compose(p)
    p = command("folders", "list mailbox folders")
    p.add_argument("account")
    p = command("attachment", "download an attachment without marking mail read")
    p.add_argument("account")
    p.add_argument("uid", type=positive)
    p.add_argument("index", type=positive, help="1-based index from read output")
    p.add_argument(
        "--output",
        required=True,
        help="new file or existing directory; never overwrites",
    )
    folder(p)
    p = command("signature", "manage deterministic signature variants")
    actions = p.add_subparsers(dest="action", required=True)
    for action in ("set", "show", "clear"):
        child = actions.add_parser(action, parents=[common])
        child.add_argument("account")
        if action != "show":
            child.add_argument("--name")
        if action == "set":
            child.add_argument("--text")
            child.add_argument("--html-file")
            child.add_argument("--default", action="store_true")
    p = command("drafts", "list, inspect, send or delete private local drafts")
    actions = p.add_subparsers(dest="action", required=True)
    for action in ("list", "show", "send", "delete"):
        child = actions.add_parser(action, parents=[common])
        if action != "list":
            child.add_argument("draft_id")
    p = command("receipts", "inspect SMTP submission receipts")
    p.add_argument("request_id", nargs="?")
    return parser


def redact(value, accounts):
    secrets = [a.get("password") for a in accounts.values() if a.get("password")]

    def clean(item):
        if isinstance(item, str):
            for secret in secrets:
                item = item.replace(secret, "[REDACTED]")
            return item
        if isinstance(item, dict):
            return {
                clean(str(k)): clean(v)
                for k, v in item.items()
                if str(k).lower() != "password"
            }
        if isinstance(item, (tuple, list)):
            return [clean(v) for v in item]
        return item

    return clean(value)


def terminal(value):
    # Incoming messages may contain terminal escape/clipboard commands.
    return "".join(
        c
        if c in "\n\t" or (ord(c) >= 32 and not 127 <= ord(c) <= 159)
        else "\\x{:02x}".format(ord(c))
        for c in str(value)
    )


def output(result, as_json=False):
    result = {"schema_version": SCHEMA_VERSION, **result}
    if as_json:
        print(json.dumps(result, ensure_ascii=True, indent=2))
    elif "error" in result and "status" not in result:
        print(
            terminal(
                "{}: {}".format(result["error"]["code"], result["error"]["message"])
            ),
            file=sys.stderr,
        )
    elif "body" in result:
        for key in ("from", "to", "date", "subject"):
            print(terminal("{}: {}".format(key.title(), result.get(key, ""))))
        print("-" * 60)
        print(terminal(result["body"]))
        if result.get("truncated"):
            print("[Body truncated; omit --limit to read the full message.]")
        for att in result.get("attachments", []):
            print(
                terminal("Attachment {index}: {filename} ({size} bytes)".format(**att))
            )
    elif "messages" in result:
        for item in result["messages"]:
            print(
                terminal(
                    "{} {} | {} | {}".format(
                        " " if item.get("seen") else "*",
                        item["uid"],
                        item.get("from", ""),
                        item.get("subject", ""),
                    )
                )
            )
        if not result["messages"]:
            print("No matching messages.")
    elif "accounts" in result:
        for addr, data in result["accounts"].items():
            if "error" in data:
                print(terminal("{}  ERROR: {}".format(addr, data["error"]["message"])))
            else:
                print(
                    terminal(
                        "{}  unread={}".format(
                            addr, data.get("unread", data.get("total", 0))
                        )
                    )
                )
                for item in data.get("messages", []):
                    print(
                        terminal(
                            "  {} | {} | {}".format(
                                item["uid"], item["from"], item["subject"]
                            )
                        )
                    )
    else:
        print(terminal(json.dumps(result, indent=2, ensure_ascii=False)))


def error_data(exc, accounts):
    return redact(
        {"code": exc.code, "message": str(exc), "details": getattr(exc, "details", {})},
        accounts,
    )


def body_text(args):
    if args.body != "-":
        return args.body
    if sys.stdin.isatty():
        raise UsageError("Supply --body text or pipe the message body through stdin.")
    return sys.stdin.read()


def preview(msg):
    part = msg.get_body(preferencelist=("plain", "html"))
    return {
        "from": str(msg.get("From", "")),
        "to": str(msg.get("To", "")),
        "cc": str(msg.get("Cc", "")),
        "subject": str(msg.get("Subject", "")),
        "body": part.get_content() if part else "",
        "attachments": [
            {
                "filename": p.get_filename(),
                "content_type": p.get_content_type(),
                "size": len(p.get_payload(decode=True) or b""),
            }
            for p in msg.iter_attachments()
        ],
    }


def receipt_public(receipt):
    return {k: v for k, v in receipt.items() if k != "fingerprint"}


def receipt_exit(receipt):
    return {"accepted": 0, "partial": 2, "uncertain": 3}.get(receipt["status"], 1)


def submit(accounts, addr, msg, request_id, timeout, reply_context=None):
    account = accounts[addr]
    receipt, claimed = state.claim_request(request_id, addr, msg)
    if not claimed:
        return receipt_public(receipt), receipt_exit(receipt)
    try:
        receipt.update(
            redact(
                mail.submit_message(
                    addr, account["password"], account, msg, timeout=timeout
                ),
                accounts,
            )
        )
    except mail.MailError as exc:
        receipt["status"] = exc.details.get("status", "failed")
        if receipt["status"] == "not_submitted":
            receipt["status"] = "failed"
        receipt["error"] = error_data(exc, accounts)
    except Exception:
        receipt["status"] = "uncertain"
        receipt["error"] = {
            "code": "SUBMISSION_UNCERTAIN",
            "message": "Submission outcome is unknown; check the server before making a new request.",
            "details": {},
        }

    def persist():
        try:
            state.save_receipt(receipt)
        except state.StateError:
            warning = "Could not persist the submission outcome; the retry key remains protected."
            if warning not in receipt["warnings"]:
                receipt["warnings"].append(warning)

    # Record acceptance before Sent/Answered network calls. Their failures must
    # never erase evidence of acceptance or encourage a duplicate submission.
    persist()
    if receipt["status"] in ("accepted", "partial"):
        try:
            receipt["sent_copy"] = mail.archive_sent(
                addr, account["password"], account, msg, timeout=timeout
            )
            if receipt["sent_copy"]["status"] == "unavailable":
                receipt["warnings"].append(
                    "Sent folder was not identified; configure sent_folder to save a copy."
                )
        except Exception:
            receipt["sent_copy"] = {"status": "failed"}
            receipt["warnings"].append(
                "SMTP accepted the message, but the Sent copy could not be saved."
            )
        if reply_context:
            try:
                options = {"folder": reply_context["folder"], "timeout": timeout}
                if reply_context.get("uidvalidity"):
                    options["uidvalidity"] = reply_context["uidvalidity"]
                mail.mark_answered(
                    addr, account["password"], account, reply_context["uid"], **options
                )
                receipt["answered_flag"] = "saved"
            except Exception:
                receipt["answered_flag"] = "failed"
                receipt["warnings"].append(
                    "SMTP accepted the reply, but the original message's Answered flag could not be saved."
                )
        persist()
    return receipt_public(receipt), receipt_exit(receipt)


def compose(args, accounts, timeout):
    addr = config.resolve(accounts, args.account)
    account = accounts[addr]
    body = body_text(args)
    signature = (
        None if args.no_signature else config.get_signature(addr, args.signature)
    )
    options = {
        "display_name": account.get("display_name"),
        "signature": signature,
        "attachments": args.attach,
    }
    context = None
    if args.command == "reply":
        orig, original_body = mail.reply_source(
            addr,
            account["password"],
            account,
            args.uid,
            folder=args.folder,
            timeout=timeout,
        )
        recipients = mail.reply_recipients(orig)
        subject = str(orig.get("Subject", ""))
        if not subject.lower().startswith("re:"):
            subject = "Re: " + subject
        message_id = str(orig.get("Message-ID", "")).strip()
        refs = str(orig.get("References", orig.get("In-Reply-To", ""))).strip()
        options["in_reply_to"] = message_id or None
        options["references"] = (refs + " " + message_id).strip() or None
        body += "\n\nOn {}, {} wrote:\n{}".format(
            orig.get("Date", ""),
            orig.get("From", ""),
            "\n".join("> " + line for line in original_body.splitlines()),
        )
        context = {
            "uid": args.uid,
            "folder": args.folder,
            "uidvalidity": getattr(orig, "_musepost_uidvalidity", None),
        }
    else:
        recipients, subject = args.to, args.subject
        if args.cc:
            options["cc"] = args.cc
    msg = mail.create_message(addr, recipients, subject, body, **options)
    if args.preview:
        return {
            "status": "preview",
            "account": addr,
            "message_id": str(msg["Message-ID"]),
            "preview": preview(msg),
        }, 0
    if args.draft:
        return {**state.create_draft(addr, msg, context), "preview": preview(msg)}, 0
    return submit(
        accounts, addr, msg, args.request_id or uuid.uuid4().hex, timeout, context
    )


def download(args, addr, account, timeout):
    filename, content = mail.get_attachment(
        addr,
        account["password"],
        account,
        args.uid,
        args.index,
        folder=args.folder,
        timeout=timeout,
    )
    destination = Path(args.output).expanduser()
    if destination.is_dir():
        filename = filename.replace("\\", "/").rsplit("/", 1)[-1]
        filename = "".join(c for c in filename if ord(c) >= 32 and ord(c) != 127)
        destination /= (
            filename
            if filename not in ("", ".", "..")
            else "attachment-{}".format(args.index)
        )
    try:
        fd = os.open(
            str(destination),
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
    except FileExistsError:
        raise config.ConfigError(
            "OUTPUT_EXISTS", "Attachment destination exists; choose a new file."
        ) from None
    except OSError:
        raise config.ConfigError(
            "OUTPUT_UNWRITABLE", "Could not write the attachment destination."
        ) from None
    return {
        "status": "saved",
        "account": addr,
        "uid": str(args.uid),
        "index": args.index,
        "path": str(destination),
        "size": len(content),
    }, 0


def dispatch(args, accounts):
    timeout = getattr(args, "timeout", 30)
    command = args.command
    if command == "receipts":
        return (
            receipt_public(state.get_receipt(args.request_id))
            if args.request_id
            else {"receipts": [receipt_public(r) for r in state.list_receipts()]}
        ), 0
    if command == "drafts":
        if args.action == "list":
            return {"drafts": state.list_drafts()}, 0
        metadata, msg = state.load_draft(args.draft_id)
        if args.action == "show":
            return {**metadata, "preview": preview(msg)}, 0
        if args.action == "delete":
            state.delete_draft(args.draft_id)
            return {"status": "deleted", "draft_id": args.draft_id}, 0
        addr = config.resolve(accounts, metadata["account"])
        if parseaddr(str(msg.get("From", "")))[1].lower() != addr:
            raise state.StateError(
                "INVALID_STATE", "Draft sender does not match its configured account."
            )
        return submit(
            accounts,
            addr,
            msg,
            "draft:" + args.draft_id,
            timeout,
            metadata.get("reply_context"),
        )
    if command in ("inboxes", "unread"):
        targets = (
            [config.resolve(accounts, args.account)]
            if getattr(args, "account", None)
            else sorted(accounts)
        )

        def fetch(addr):
            account = accounts[addr]
            try:
                if command == "inboxes":
                    result = mail.inbox_status(
                        addr, account["password"], account, timeout=timeout
                    )
                else:
                    result = mail.list_messages(
                        addr,
                        account["password"],
                        account,
                        folder=args.folder,
                        limit=args.limit,
                        unread=True,
                        timeout=timeout,
                    )
                    result["unread"] = result["total"]
                return addr, result
            except mail.MailError as exc:
                return addr, {"error": error_data(exc, accounts)}
            except Exception:
                return addr, {
                    "error": {
                        "code": "MAILBOX_FAILED",
                        "message": "Mailbox operation failed.",
                        "details": {},
                    }
                }

        with ThreadPoolExecutor(max_workers=min(4, len(targets))) as executor:
            results = dict(executor.map(fetch, targets))
        return {"accounts": results}, 1 if any(
            "error" in v for v in results.values()
        ) else 0
    if command in ("send", "reply"):
        return compose(args, accounts, timeout)
    addr = config.resolve(accounts, args.account)
    account = accounts[addr]
    password = account["password"]
    if command in ("read", "peek"):
        return mail.read_message(
            addr,
            password,
            account,
            args.uid,
            folder=args.folder,
            mark_read=getattr(args, "mark_read", False),
            max_chars=args.limit,
            timeout=timeout,
        ), 0
    if command in ("list", "search"):
        limit = (
            (
                args.limit
                if args.limit is not None
                else args.n
                if args.n is not None
                else 10
            )
            if command == "list"
            else args.limit
        )
        return mail.list_messages(
            addr,
            password,
            account,
            folder=args.folder,
            limit=limit,
            query=" ".join(args.query) if command == "search" else None,
            timeout=timeout,
        ), 0
    if command == "folders":
        return {
            "account": addr,
            "folders": mail.folders(addr, password, account, timeout=timeout),
        }, 0
    if command == "attachment":
        return download(args, addr, account, timeout)
    if command == "signature":
        if args.action == "show":
            return {"account": addr, **config.signatures_for(addr)}, 0
        if args.action == "clear":
            config.clear_signature(addr, args.name)
            return {"status": "cleared", "account": addr, "name": args.name}, 0
        html = (
            Path(args.html_file).expanduser().read_text(encoding="utf-8")
            if args.html_file
            else None
        )
        return {
            "status": "saved",
            "account": addr,
            **config.set_signature(
                addr, name=args.name, text=args.text, html=html, default=args.default
            ),
        }, 0
    raise UsageError("Unknown command.")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    parser = build_parser()
    if not argv or argv == ["help"]:
        parser.print_help()
        return 0
    accounts = {}
    as_json = "--json" in argv
    try:
        try:
            args = parser.parse_args(argv)
        except SystemExit as exc:
            return exc.code
        as_json = getattr(args, "as_json", False)
        local = args.command == "receipts" or (
            args.command == "drafts" and args.action != "send"
        )
        if not local:
            accounts = config.load_accounts(getattr(args, "config_path", None))
        result, code = dispatch(args, accounts)
        output(redact(result, accounts), as_json)
        return code
    except (UsageError, config.ConfigError, state.StateError, mail.MailError) as exc:
        output({"error": error_data(exc, accounts)}, as_json)
        return (
            2
            if isinstance(exc, UsageError)
            else 3
            if getattr(exc, "details", {}).get("status") == "uncertain"
            else 1
        )
    except (OSError, ValueError, UnicodeError):
        output(
            {
                "error": {
                    "code": "OPERATION_FAILED",
                    "message": "Could not complete the local operation.",
                    "details": {},
                }
            },
            as_json,
        )
        return 1
    except KeyboardInterrupt:
        output(
            {
                "error": {
                    "code": "INTERRUPTED",
                    "message": "Operation interrupted. Check its receipt before repeating a send.",
                    "details": {},
                }
            },
            as_json,
        )
        return 130


if __name__ == "__main__":
    sys.exit(main())
